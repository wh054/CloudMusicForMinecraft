{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/gradlew-java8.sh",
                "build",
                "--console=plain"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\gradlew-java8.ps1",
                    "build",
                    "--console=plain"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Client",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/gradlew-java8.sh",
                "runClient",
                "--console=plain"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\gradlew-java8.ps1",
                    "runClient",
                    "--console=plain"
                ]
            },
            "group": "none",
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "Run Server",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/gradlew-java8.sh",
                "runServer",
                "--console=plain"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\gradlew-java8.ps1",
                    "runServer",
                    "--console=plain"
                ]
            },
            "group": "none",
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "Run Client (Debug)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/gradlew-java8.sh",
                "runClient",
                "-Pdebug",
                "--console=plain"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\gradlew-java8.ps1",
                    "runClient",
                    "-Pdebug",
                    "--console=plain"
                ]
            },
            "group": "none",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^Listening for transport dt_socket at address: (\\d+)$",
                    "line": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^> Task :runClient$",
                    "endsPattern": "^Listening for transport dt_socket at address: \\d+$"
                }
            }
        },
        {
            "label": "Run Server (Debug)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/gradlew-java8.sh",
                "runServer",
                "-Pdebug",
                "--console=plain"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\gradlew-java8.ps1",
                    "runServer",
                    "-Pdebug",
                    "--console=plain"
                ]
            },
            "group": "none",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^Listening for transport dt_socket at address: (\\d+)$",
                    "line": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^> Task :runServer$",
                    "endsPattern": "^Listening for transport dt_socket at address: \\d+$"
                }
            }
        }
    ]
}
