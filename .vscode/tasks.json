{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "./gradlew build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Client",
            "type": "shell",
            "command": "./gradlew runClient",
            "group": "none",
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "Run Server",
            "type": "shell",
            "command": "./gradlew runServer",
            "group": "none",
            "problemMatcher": [],
            "isBackground": true
        },
        {
            "label": "Run Client (Debug)",
            "type": "shell",
            "command": "./gradlew runClient -Pdebug",
            "group": "none",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^Listening for transport dt_socket at address: (\\d+)$",
                    "line": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^> Task :runClient$",
                    "endsPattern": "^Listening for transport dt_socket at address: \\d+$"
                }
            }
        },
        {
            "label": "Run Server (Debug)",
            "type": "shell",
            "command": "./gradlew runServer -Pdebug",
            "group": "none",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^Listening for transport dt_socket at address: (\\d+)$",
                    "line": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^> Task :runServer$",
                    "endsPattern": "^Listening for transport dt_socket at address: \\d+$"
                }
            }
        }
    ]
}
